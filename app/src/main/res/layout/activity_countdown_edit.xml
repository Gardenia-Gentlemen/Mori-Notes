<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="倒数日"
            app:titleTextColor="?attr/colorOnSurface" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="32dp">

                <!-- 卡片一：是什么日子 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_basic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp">

                        <EditText
                            android:id="@+id/et_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:gravity="top|start"
                            android:hint="记一个重要的日子"
                            android:inputType="textCapSentences"
                            android:maxLines="2"
                            android:minHeight="48dp"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOutline"
                            android:importantForAutofill="no" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="2dp"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:id="@+id/row_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="公历"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="?attr/colorOnSurface" />
                            <TextView
                                android:id="@+id/tv_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:maxLines="1"
                                android:text="选择日期"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorPrimary" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:id="@+id/row_lunar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="农历"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="?attr/colorOnSurface" />
                            <TextView
                                android:id="@+id/tv_lunar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:maxLines="1"
                                android:text="选择农历日期"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorPrimary" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:id="@+id/row_days"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="距今"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="?attr/colorOnSurface" />
                            <TextView
                                android:id="@+id/tv_elapsed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:maxLines="1"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="6dp"
                            android:background="?attr/colorOutlineVariant" />

                        <EditText
                            android:id="@+id/et_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:gravity="top|start"
                            android:hint="备注（可选）"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="4"
                            android:minHeight="60dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOutline"
                            android:importantForAutofill="no" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_pinned"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="6dp"
                            android:text="置顶"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 卡片二：日切与蒙版 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="日切与蒙版"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="日切时间决定这条倒数日几点算「新的一天」；蒙版强度控制卡片背景图上的黑色遮罩。"
                            android:textSize="13sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_day_start_edit"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="日切时间：0 点" />
                        <TextView
                            android:id="@+id/tv_mask_label_edit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="蒙版强度：40%"
                            android:textSize="14sp" />
                        <com.google.android.material.slider.Slider
                            android:id="@+id/slider_mask_edit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:stepSize="5"
                            android:value="40"
                            android:valueFrom="0"
                            android:valueTo="80" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reset_global_edit"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="恢复为全局设置" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- 卡片三：怎么计数 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_rule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="计数方式"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />

                                                <LinearLayout
                            android:id="@+id/seg_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_seg_container"
                            android:orientation="horizontal"
                            android:padding="4dp">
                        <TextView
                            android:id="@+id/btn_mode_down"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_mode_down"
                            android:drawablePadding="8dp"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="倒数模式"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                        <TextView
                            android:id="@+id/btn_mode_up"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_mode_up"
                            android:drawablePadding="8dp"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="累计模式"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/group_anniv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="纪念日"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="?attr/colorPrimary" />
                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/sw_anniv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:checked="true"
                                    />
                                </LinearLayout>
                            <LinearLayout
                                android:id="@+id/group_anniv_body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_panel"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <LinearLayout
                                    android:id="@+id/seg_anniv"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_seg_container"
                                    android:orientation="horizontal"
                                    android:padding="4dp">
                        <TextView
                            android:id="@+id/btn_anniv_days"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="纪念天数"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                        <TextView
                            android:id="@+id/btn_anniv_calendar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="预设纪念"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                                </LinearLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_custom_days"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="自定义周期（N 天）">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_custom_days"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="100"
                                        android:inputType="number"
                                        android:maxLength="5"
                                        android:textAppearance="?attr/textAppearanceTitleMedium"
                                        android:importantForAutofill="no" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <LinearLayout
                                    android:id="@+id/group_show_cal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:paddingTop="8dp">
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="年"
                                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                                        <com.google.android.material.materialswitch.MaterialSwitch
                                            android:id="@+id/sw_show_year"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:paddingTop="8dp">
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="月"
                                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                                        <com.google.android.material.materialswitch.MaterialSwitch
                                            android:id="@+id/sw_show_month"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:paddingTop="8dp">
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="周"
                                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                                        <com.google.android.material.materialswitch.MaterialSwitch
                                            android:id="@+id/sw_show_week"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content" />
                                    </LinearLayout>
                                </LinearLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_anniv_message"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="纪念日文案（可选）">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_anniv_message"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="纪念日"
                                        android:inputType="textCapSentences"
                                        android:maxLines="2"
                                        android:importantForAutofill="no" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/group_repeat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="重复周期"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="?attr/colorPrimary" />
                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/sw_repeat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:checked="true"
                                    />
                                </LinearLayout>
                            <LinearLayout
                                android:id="@+id/group_repeat_body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_panel"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <LinearLayout
                                    android:id="@+id/seg_repeat"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_seg_container"
                                    android:orientation="horizontal"
                                    android:padding="4dp">
                        <TextView
                            android:id="@+id/btn_rep_year"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="年"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                        <TextView
                            android:id="@+id/btn_rep_month"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="月"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                        <TextView
                            android:id="@+id/btn_rep_week"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="周"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                        <TextView
                            android:id="@+id/btn_rep_day"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="天"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                                </LinearLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_repeat_interval"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="间隔数量"
                                    app:suffixText="年">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_repeat_interval"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="1"
                                        android:inputType="number"
                                        android:maxLength="3"
                                        android:textAppearance="?attr/textAppearanceTitleMedium"
                                        android:importantForAutofill="no" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:text="过期后目标日期自动推进"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 卡片三：外观 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:id="@+id/row_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="64dp"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="背景图片"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />
                        <ImageView
                            android:id="@+id/iv_bg_preview"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:background="?attr/colorSurfaceVariant"
                            android:contentDescription="背景预览"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                        <TextView
                            android:id="@+id/tv_bg_clear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp"
                            android:text="移除"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOutline"
                            android:visibility="gone" />
                        <TextView
                            android:id="@+id/tv_bg_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="选择"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_created"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
