<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="倒数日"
            app:titleTextColor="?attr/colorOnSurface" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <EditText
                    android:id="@+id/et_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="记一个重要的日子"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:minHeight="48dp"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOutline"
                    android:importantForAutofill="no" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:id="@+id/row_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="日期"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />
                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:gravity="end"
                        android:text="选择日期"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="8dp"
                    android:background="?attr/colorOutlineVariant" />

                <EditText
                    android:id="@+id/et_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="备注（可选）"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minHeight="72dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOutline"
                    android:importantForAutofill="no" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_pinned"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="置顶"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="计数方式"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary" />

                <RadioGroup
                    android:id="@+id/rg_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_down"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="倒数（距离这天还有多久）"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_up"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="累计（这天已经过去多久）"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="纪念日"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary" />

                <RadioGroup
                    android:id="@+id/rg_anniv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_anniv_none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="不显示"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_anniv_days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="按天数记（第 N 次）"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_anniv_calendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="按年月记（第 N 年 / 月 / 周）"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/group_custom_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="间隔天数"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />
                    <EditText
                        android:id="@+id/et_custom_days"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:hint="100"
                        android:inputType="number"
                        android:maxLength="5"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOutline"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_anniv_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="自定义文案（可选，留空自动生成）"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:minHeight="48dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOutline"
                    android:importantForAutofill="no" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="重复"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary" />

                <RadioGroup
                    android:id="@+id/rg_repeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_repeat_none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="不重复"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_repeat_yearly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="每年"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_repeat_monthly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="每月"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_repeat_weekly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="每周"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/row_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="背景图片"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />
                    <ImageView
                        android:id="@+id/iv_bg_preview"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:background="?attr/colorSurfaceVariant"
                        android:contentDescription="背景预览"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tv_bg_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="12dp"
                        android:text="移除"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOutline"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tv_bg_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选择"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_created"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOutline"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
